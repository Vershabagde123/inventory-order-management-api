# ---------------------------------------------------------------
# Copy this file to .env and replace the placeholders.
# NEVER commit .env.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Neon POOLED connection (host contains "-pooler"). Used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon DIRECT connection (host WITHOUT "-pooler"). Used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="1d"

BCRYPT_SALT_ROUNDS=12

# Comma-separated list of allowed browser origins ("*" allows all)
CORS_ORIGIN="*"

# Used by `npm run db:seed`
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_ADMIN_PASSWORD"
SEED_SAMPLE_PRODUCTS=true

# Integration tests run in an ISOLATED Postgres schema so they never touch
# application data in the "public" schema. Must not be "public".
TEST_DB_SCHEMA="inventory_test"
