// Prisma schema - Inventory & Order Management API
//
// Prisma 7: connection URLs are NOT declared here.
//   - Prisma CLI / Migrate reads DIRECT_URL via prisma.config.ts
//   - The application connects with DATABASE_URL (Neon pooled) via @prisma/adapter-pg
//
// CHECK constraints (price > 0, stock >= 0, quantity > 0, ...) cannot be expressed
// in Prisma Schema Language; they are added in the SQL migration itself.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255) // bcrypt hash - never returned by the API
  role      Role     @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("users")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  sku       String   @unique @db.VarChar(64)
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([name])
  @@index([stock])
  @@map("products")
}

model Order {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // A user with order history cannot be deleted (keeps the audit trail intact).
  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items OrderItem[]

  @@index([userId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(12, 2) // unit price snapshot at purchase time

  // Items live and die with their order.
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // A product that appears in any order cannot be deleted (409 Conflict).
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}
